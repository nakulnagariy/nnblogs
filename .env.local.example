# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin access — comma-separated list of Supabase Auth emails allowed into
# /admin and /api/admin/*. Any other authenticated user is treated as a
# regular (non-admin) account.
ADMIN_EMAILS=you@example.com

# GitHub Integration
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_personal_access_token

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# OpenAI Integration (for AI content generation)
OPENAI_API_KEY=your_openai_api_key

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=NNBlogs
NEXT_PUBLIC_SITE_DESCRIPTION=Personal blog, projects, and interview-prep notes by Nakul Nagariya
